#!/usr/bin/env bash
# mkwall -- turn ordinary images into e-ink-ready KOReader sleep-screen wallpapers.
#
# Usage:
#   mkwall sources/                      # whole folder -> out/
#   mkwall sources/photo.jpg             # one file
#   mkwall -d pw3 -o out sources/*.jpg   # explicit device and output dir
#   mkwall --fit pad --bg white sources/ # letterbox instead of crop
#   mkwall --levels 16 --dither sources/ # bake a 16-level dither (kills banding)
#   mkwall --list-devices
#
# Defaults target a Kindle Paperwhite 3 (7th gen): 1072x1448, 8-bit grayscale
# PNG, no alpha, metadata stripped, midtones lifted slightly for e-ink.
#
# Requires ImageMagick 7 (`magick`).

set -uo pipefail

PROG=${0##*/}

# --- device presets: name  width  height -------------------------------------
DEVICES=(
  "pw3     1072 1448  Paperwhite 3/4 (7th-10th gen), Voyage, 6in 300ppi"
  "pw5     1236 1648  Paperwhite 5/6 (11th-12th gen), Signature, 6.8in"
  "basic   600  800   Basic Kindle 7th-9th gen, 6in 167ppi"
  "basic11 1072 1448  Basic Kindle 11th gen, 6in 300ppi"
  "oasis   1264 1680  Oasis 2/3, 7in"
  "scribe  1860 2480  Scribe, 10.2in"
  "colorsoft 1264 1680  Colorsoft, 7in"
)

# --- defaults ----------------------------------------------------------------
device=pw3
outdir=out
fit=crop            # crop | pad | stretch
bg=white
bc="5x8"            # -brightness-contrast; "none" to skip
levels=0            # 0 = leave full 8-bit ramp; 16 = quantize to panel levels
dither=none         # none | fs
format=png
quality=92
landscape=0
force=0
dryrun=0
quiet=0
size_warn=1048576   # warn above 1 MB

die()  { printf '%s: %s\n' "$PROG" "$1" >&2; exit "${2:-1}"; }
warn() { printf '%s: %s\n' "$PROG" "$1" >&2; }
say()  { ((quiet)) || printf '%s\n' "$1"; }

usage() {
  sed -n '2,/^# Requires/p' "$0" | sed 's/^# \{0,1\}//'
  cat <<'EOF'

Options:
  -d, --device NAME    device preset (default: pw3); see --list-devices
  -s, --size WxH       explicit pixel size, overrides --device
  -o, --outdir DIR     output directory (default: out)
      --fit MODE       crop (fill + centre-crop, default) | pad | stretch
      --bg COLOR       pad colour (default: white)
      --bc AxB         brightness-contrast, or "none" (default: 5x8)
      --levels N       quantize to N gray levels, 0 = off (default: 0)
      --dither         Floyd-Steinberg when quantizing (default: off)
      --jpg            write JPEG instead of PNG
  -q, --quality N      JPEG quality (default: 92)
      --landscape      swap width/height
  -f, --force          overwrite existing outputs
  -n, --dry-run        show what would be done
      --quiet          only report problems
      --list-devices   print presets and exit
  -h, --help           this help
EOF
}

list_devices() {
  printf '%-10s %-11s %s\n' NAME SIZE NOTES
  local d name w h notes
  for d in "${DEVICES[@]}"; do
    read -r name w h notes <<<"$d"
    printf '%-10s %-11s %s\n' "$name" "${w}x${h}" "$notes"
  done
}

lookup_device() {
  local want=$1 d name w h notes
  for d in "${DEVICES[@]}"; do
    read -r name w h notes <<<"$d"
    if [[ $name == "$want" ]]; then
      W=$w H=$h
      return 0
    fi
  done
  return 1
}

# --- argument parsing --------------------------------------------------------
size=""
args=()
while (($#)); do
  case $1 in
    -d|--device)   device=${2:?--device needs a name}; shift 2 ;;
    -s|--size)     size=${2:?--size needs WxH};        shift 2 ;;
    -o|--outdir)   outdir=${2:?--outdir needs a path}; shift 2 ;;
    --fit)         fit=${2:?--fit needs a mode};       shift 2 ;;
    --bg)          bg=${2:?--bg needs a colour};       shift 2 ;;
    --bc)          bc=${2:?--bc needs AxB or none};    shift 2 ;;
    --levels)      levels=${2:?--levels needs N};      shift 2 ;;
    --dither)      dither=fs;                          shift ;;
    --jpg|--jpeg)  format=jpg;                         shift ;;
    -q|--quality)  quality=${2:?--quality needs N};    shift 2 ;;
    --landscape)   landscape=1;                        shift ;;
    -f|--force)    force=1;                            shift ;;
    -n|--dry-run)  dryrun=1;                           shift ;;
    --quiet)       quiet=1;                            shift ;;
    --list-devices) list_devices; exit 0 ;;
    -h|--help)     usage; exit 0 ;;
    --)            shift; args+=("$@"); break ;;
    -*)            die "unknown option: $1 (try --help)" 2 ;;
    *)             args+=("$1"); shift ;;
  esac
done

command -v magick >/dev/null || die "ImageMagick 7 not found (need the 'magick' command)"

case $fit in crop|pad|stretch) ;; *) die "--fit must be crop, pad or stretch" 2 ;; esac
[[ $levels =~ ^[0-9]+$ ]] || die "--levels must be a number" 2
(( levels == 0 || levels >= 2 )) || die "--levels must be 0 or >= 2" 2

if [[ -n $size ]]; then
  [[ $size =~ ^([0-9]+)x([0-9]+)$ ]] || die "--size must look like 1072x1448" 2
  W=${BASH_REMATCH[1]} H=${BASH_REMATCH[2]}
  device="custom"
else
  lookup_device "$device" || die "unknown device '$device' (see --list-devices)" 2
fi
((landscape)) && { t=$W; W=$H; H=$t; }

# --- collect inputs ----------------------------------------------------------
((${#args[@]})) || { usage; exit 2; }

inputs=()
for a in "${args[@]}"; do
  if [[ -d $a ]]; then
    while IFS= read -r -d '' f; do inputs+=("$f"); done < <(
      find "$a" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
           -o -iname '*.tif' -o -iname '*.tiff' -o -iname '*.webp' \
           -o -iname '*.bmp' -o -iname '*.gif' -o -iname '*.heic' \
           -o -iname '*.avif' -o -iname '*.svg' -o -iname '*.pdf' \) \
        -print0 | sort -z
    )
  elif [[ -f $a ]]; then
    inputs+=("$a")
  else
    warn "skipping '$a': not a file or directory"
  fi
done
((${#inputs[@]})) || die "no images found"

((dryrun)) || mkdir -p "$outdir" || die "cannot create '$outdir'"

say "$PROG: $device ${W}x${H}, fit=$fit, grayscale ${format}$( ((levels)) && printf ', %s levels (dither=%s)' "$levels" "$dither" ) -> $outdir/"

# --- shared magick arguments -------------------------------------------------
pre=(-auto-orient -background "$bg" -alpha remove -alpha off -colorspace Gray)

case $fit in
  crop)    geom=(-filter Lanczos -resize "${W}x${H}^" -gravity center -extent "${W}x${H}") ;;
  pad)     geom=(-filter Lanczos -resize "${W}x${H}"  -gravity center -extent "${W}x${H}") ;;
  stretch) geom=(-filter Lanczos -resize "${W}x${H}!") ;;
esac

tone=()
[[ $bc != none ]] && tone=(-brightness-contrast "$bc")

# Quantizing via -remap onto a generated N-step ramp, rather than -colors:
# -colors picks its own palette and leaks a few extra levels through Q16
# rounding, while the ramp is exactly the evenly-spaced set an N-level e-ink
# panel can actually show.
quant=()
palette=""
if ((levels)); then
  palette=$(mktemp -t "mkwall-ramp-XXXXXX.png") || die "cannot create temp file"
  trap 'rm -f "$palette"' EXIT
  magick -size "${levels}x1" gradient:black-white -colorspace Gray -depth 8 "$palette" \
    || die "could not build a ${levels}-level gray ramp"
  if [[ $dither == fs ]]; then
    quant=(-dither FloydSteinberg -remap "$palette")
  else
    quant=(+dither -remap "$palette")
  fi
fi

post=(-colorspace Gray -depth 8 -strip)
if [[ $format == png ]]; then
  post+=(-define png:color-type=0 -define png:bit-depth=8)
else
  post+=(-quality "$quality" -sampling-factor 1x1 -interlace Plane)
fi

# --- process -----------------------------------------------------------------
ok=0 failed=0 skipped=0
target_ar=$(awk -v w="$W" -v h="$H" 'BEGIN{printf "%.6f", w/h}')

for src in "${inputs[@]}"; do
  base=${src##*/}
  dst="$outdir/${base%.*}.$format"

  if [[ -e $dst ]] && ((!force)); then
    warn "exists, skipping (use -f): $dst"
    ((skipped++))
    continue
  fi

  # Warn when a centre-crop is about to throw away a lot of the frame.
  if [[ $fit == crop ]]; then
    read -r sw sh < <(magick identify -format '%w %h' "$src[0]" 2>/dev/null || echo "0 0")
    if ((sw > 0 && sh > 0)); then
      loss=$(awk -v sw="$sw" -v sh="$sh" -v ar="$target_ar" 'BEGIN{
        src=sw/sh
        kept = (src > ar) ? ar/src : src/ar
        printf "%d", (1-kept)*100
      }')
      ((loss >= 15)) && warn "$base: ${sw}x${sh} -> crop discards ~${loss}% of the frame (--fit pad keeps it all)"
    fi
  fi

  if ((dryrun)); then
    say "  would write $dst"
    ((ok++))
    continue
  fi

  if magick "$src[0]" "${pre[@]}" "${geom[@]}" "${tone[@]}" "${quant[@]}" \
       "${post[@]}" "$dst" 2>/dev/null; then
    bytes=$(stat -c %s "$dst")
    say "  $dst  $(numfmt --to=iec --suffix=B "$bytes")"
    ((bytes > size_warn)) && warn "$dst is large for a sleep screen; try --jpg or --levels 16"
    ((ok++))
  else
    warn "failed: $src"
    rm -f "$dst"
    ((failed++))
  fi
done

say "$PROG: $ok written, $skipped skipped, $failed failed"
((failed == 0))
